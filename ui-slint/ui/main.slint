// Lucida — native mirror (U5). Same night sky as ui-web, rendered by Slint:
// dashboard panels + Atlas and Thought lenses only (charter: the simplified
// field — brightest stars, batched Path edges, timer-driven ripple).
// Palette transcribed from ui-web/style.css — the two skies must match.

import { ListView, LineEdit } from "std-widgets.slint";

export global Pal {
    out property <color> ground:     #070b12;
    out property <color> panel:      #0d1422db;
    out property <color> panel-line: #7a98c729;
    out property <color> ink:        #d8e1ef;
    out property <color> ink2:       #8fa0b8;
    out property <color> ink3:       #5a6a82;
    out property <color> accent:     #3a7de0;
    out property <color> accent-hi:  #cfe0f8;
}

// One star, fully flattened by Rust (house discipline): field coords, screen
// sizes, premultiplied halo alpha. Slint only places and paints.
export struct StarItem {
    fx: float,
    fy: float,
    size: float,      // core diameter, px
    core: color,      // type hue
    halo: color,      // type hue, glow alpha baked in
    boost: float,     // 0..1 trace ignition
    seed: bool,
    dimmed: bool,
}

export struct TypeStat {
    name: string,
    count: string,
    hue: color,
}

export struct ResultItem {
    id: string,
    rank: string,
    score: string,
    head: string,
    hue: color,
    lit: bool,
}

export component MainWindow inherits Window {
    title: "Lucida — CerebroCortex observatory (native)";
    background: Pal.ground;
    preferred-width: 1280px;
    preferred-height: 840px;
    default-font-size: 13px;

    // ---- field data (Rust-set) ----
    in property <[StarItem]> stars;
    in property <string> edge-cmds;
    in property <string> focus-cmds;
    in property <string> trace-done-cmds;
    in property <string> trace-active-cmds;

    // ---- panels (Rust-set) ----
    in property <string> db-line: "connecting…";
    in property <string> api-line;
    in property <string> meta-line;
    in property <string> totals-line;
    in property <string> trace-meta;
    in property <string> status-line;
    in property <bool> connected: false;
    in property <bool> busy: false;
    in property <[TypeStat]> type-stats;
    in property <[ResultItem]> results;

    // ---- hover / selection markers (Rust-set, field coords) ----
    in property <bool> hover-visible: false;
    in property <float> hover-fx;
    in property <float> hover-fy;
    in property <color> hover-hue: Pal.ink2;
    in property <string> hover-text;
    in property <bool> sel-visible: false;
    in property <float> sel-fx;
    in property <float> sel-fy;
    in property <color> sel-hue: Pal.accent;
    in property <string> sel-type;
    in property <string> sel-id;
    in property <string> sel-content;
    in property <string> sel-tags;
    in property <string> sel-meta1;
    in property <string> sel-meta2;
    in property <string> sel-meta3;

    // ---- view state (Slint-owned; Rust may fly-to) ----
    in-out property <int> lens: 0;              // 0 = Atlas, 1 = Thought
    in-out property <float> view-cx: 0;
    in-out property <float> view-cy: 0;
    in-out property <float> zoom: 1;

    callback refresh();
    callback run-trace(string);
    callback hover-probe(float, float, float);  // fx, fy, tolerance (field units)
    callback click-probe(float, float, float);
    callback result-clicked(string);
    callback dismiss();

    // px per field unit — the whole sky (rim included, ~±1270) fits at zoom 1.
    property <float> scale: root.zoom * min(root.width / 1px, root.height / 1px) / 2600;
    property <float> half-w: root.width / 2px;
    property <float> half-h: root.height / 2px;
    // scratch for zoom-about-cursor (no locals in Slint callbacks)
    property <float> pin-fx;
    property <float> pin-fy;

    function field-x(mx: float) -> float { root.view-cx + (mx - root.half-w) / root.scale; }
    function field-y(my: float) -> float { root.view-cy + (my - root.half-h) / root.scale; }
    function zoom-at(mx: float, my: float, factor: float) {
        root.pin-fx = root.field-x(mx);
        root.pin-fy = root.field-y(my);
        root.zoom = max(0.4, min(30, root.zoom * factor));
        root.view-cx = root.pin-fx - (mx - root.half-w) / root.scale;
        root.view-cy = root.pin-fy - (my - root.half-h) / root.scale;
    }

    // ================= the field =================
    field := Rectangle {
        width: 100%;
        height: 100%;

        // base links — near-invisible by default, the field reads as stars
        Path {
            width: 100%; height: 100%;
            commands: root.edge-cmds;
            fill: transparent;
            stroke: #7a98c71f;
            stroke-width: 1px;
            viewbox-x: root.view-cx - root.half-w / root.scale;
            viewbox-y: root.view-cy - root.half-h / root.scale;
            viewbox-width: (root.width / 1px) / root.scale;
            viewbox-height: (root.height / 1px) / root.scale;
        }
        // focus mode: the selected star's links light up
        Path {
            width: 100%; height: 100%;
            commands: root.focus-cmds;
            fill: transparent;
            stroke: #3a7de0aa;
            stroke-width: 1px;
            viewbox-x: root.view-cx - root.half-w / root.scale;
            viewbox-y: root.view-cy - root.half-h / root.scale;
            viewbox-width: (root.width / 1px) / root.scale;
            viewbox-height: (root.height / 1px) / root.scale;
        }
        // recall ripple: walked edges, past hops…
        Path {
            width: 100%; height: 100%;
            commands: root.trace-done-cmds;
            fill: transparent;
            stroke: #3a7de059;
            stroke-width: 1px;
            viewbox-x: root.view-cx - root.half-w / root.scale;
            viewbox-y: root.view-cy - root.half-h / root.scale;
            viewbox-width: (root.width / 1px) / root.scale;
            viewbox-height: (root.height / 1px) / root.scale;
        }
        // …and the wavefront firing right now
        Path {
            width: 100%; height: 100%;
            commands: root.trace-active-cmds;
            fill: transparent;
            stroke: #cfe0f8e6;
            stroke-width: 1.5px;
            viewbox-x: root.view-cx - root.half-w / root.scale;
            viewbox-y: root.view-cy - root.half-h / root.scale;
            viewbox-width: (root.width / 1px) / root.scale;
            viewbox-height: (root.height / 1px) / root.scale;
        }

        // stars
        for s in root.stars: Rectangle {
            property <float> sxp: (s.fx - root.view-cx) * root.scale + root.half-w;
            property <float> syp: (s.fy - root.view-cy) * root.scale + root.half-h;
            property <float> halo-d: s.size * 3.4 + s.boost * 14;
            x: (self.sxp - self.halo-d / 2) * 1px;
            y: (self.syp - self.halo-d / 2) * 1px;
            width: self.halo-d * 1px;
            height: self.halo-d * 1px;
            opacity: s.dimmed ? 0.18 : 1.0;
            visible: self.sxp > -40 && self.sxp < root.width / 1px + 40
                  && self.syp > -40 && self.syp < root.height / 1px + 40;

            // glow halo (activation channel)
            Rectangle {
                width: 100%; height: 100%;
                border-radius: self.width / 2;
                background: @radial-gradient(circle, s.halo 0%, #00000000 100%);
            }
            // trace ignition ring
            if s.boost > 0.01: Rectangle {
                width: 100%; height: 100%;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: #cfe0f8;
                opacity: 0.25 + s.boost * 0.75;
            }
            // seed ring (hop 0)
            if s.seed: Rectangle {
                x: parent.width / 2 - s.size * 1.1px;
                y: parent.height / 2 - s.size * 1.1px;
                width: s.size * 2.2px;
                height: s.size * 2.2px;
                border-radius: self.width / 2;
                border-width: 1.5px;
                border-color: #ffffffcc;
            }
            // core
            Rectangle {
                x: (parent.width - s.size * 1px) / 2;
                y: (parent.height - s.size * 1px) / 2;
                width: s.size * 1px;
                height: s.size * 1px;
                border-radius: self.width / 2;
                background: s.core;
            }
        }

        // hover ring + selection ring (field-anchored, Rust-set)
        if root.hover-visible: Rectangle {
            x: ((root.hover-fx - root.view-cx) * root.scale + root.half-w) * 1px - 11px;
            y: ((root.hover-fy - root.view-cy) * root.scale + root.half-h) * 1px - 11px;
            width: 22px; height: 22px;
            border-radius: 11px;
            border-width: 1px;
            border-color: root.hover-hue;
        }
        if root.sel-visible: Rectangle {
            x: ((root.sel-fx - root.view-cx) * root.scale + root.half-w) * 1px - 14px;
            y: ((root.sel-fy - root.view-cy) * root.scale + root.half-h) * 1px - 14px;
            width: 28px; height: 28px;
            border-radius: 14px;
            border-width: 1.5px;
            border-color: root.sel-hue;
        }

        ta := TouchArea {
            property <bool> drag: false;
            property <float> sx;
            property <float> sy;
            property <float> scx;
            property <float> scy;
            property <float> moved2: 0;   // squared px moved since press

            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.sx = self.mouse-x / 1px;
                    self.sy = self.mouse-y / 1px;
                    self.scx = root.view-cx;
                    self.scy = root.view-cy;
                    self.moved2 = 0;
                    self.drag = true;
                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    self.drag = false;
                }
            }
            moved => {
                if (self.drag) {
                    self.moved2 = (self.mouse-x / 1px - self.sx) * (self.mouse-x / 1px - self.sx)
                                + (self.mouse-y / 1px - self.sy) * (self.mouse-y / 1px - self.sy);
                    root.view-cx = self.scx - (self.mouse-x / 1px - self.sx) / root.scale;
                    root.view-cy = self.scy - (self.mouse-y / 1px - self.sy) / root.scale;
                }
            }
            clicked => {
                if (self.moved2 < 25) {
                    root.click-probe(
                        root.field-x(self.mouse-x / 1px),
                        root.field-y(self.mouse-y / 1px),
                        14 / root.scale);
                }
            }
            scroll-event(e) => {
                root.zoom-at(self.mouse-x / 1px, self.mouse-y / 1px,
                             e.delta-y > 0px ? 1.18 : 1 / 1.18);
                return accept;
            }
        }
        // hover sampling from a Timer — never from a `changed` handler
        // (layout-coupled reads there panic "Recursion detected").
        Timer {
            interval: 90ms;
            running: ta.has-hover && !ta.drag;
            triggered => {
                root.hover-probe(
                    root.field-x(ta.mouse-x / 1px),
                    root.field-y(ta.mouse-y / 1px),
                    14 / root.scale);
            }
        }

        // hover tooltip
        if root.hover-visible: Rectangle {
            x: min(root.width - self.width - 8px,
                   ((root.hover-fx - root.view-cx) * root.scale + root.half-w) * 1px + 16px);
            y: max(8px, ((root.hover-fy - root.view-cy) * root.scale + root.half-h) * 1px - 30px);
            width: tip.preferred-width + 16px;
            height: tip.preferred-height + 8px;
            background: Pal.panel;
            border-width: 1px;
            border-color: Pal.panel-line;
            border-radius: 4px;
            tip := Text {
                x: 8px; y: 4px;
                text: root.hover-text;
                color: Pal.ink;
                font-size: 11px;
            }
        }
    }

    // ================= header bar =================
    Rectangle {
        x: 0; y: 0;
        width: 100%;
        height: 52px;
        background: @linear-gradient(180deg, #070b12eb 0%, #070b128c 80%, #070b1200 100%);

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 16px;

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "L U C I D A";
                        color: Pal.ink;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    Text {
                        text: "native mirror";
                        color: Pal.ink3;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }

            // lens toggle
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 170px;
                    height: 28px;
                    background: #0d1422b8;
                    border-width: 1px;
                    border-color: Pal.panel-line;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;
                        Rectangle {
                            background: root.lens == 0 ? #3a7de038 : transparent;
                            border-radius: 4px;
                            atlas-ta := TouchArea { clicked => { root.lens = 0; } }
                            Text {
                                text: "ATLAS";
                                color: root.lens == 0 ? Pal.accent-hi
                                     : atlas-ta.has-hover ? Pal.ink : Pal.ink2;
                                font-size: 10px;
                                letter-spacing: 1.4px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            background: root.lens == 1 ? #3a7de038 : transparent;
                            border-radius: 4px;
                            thought-ta := TouchArea { clicked => { root.lens = 1; } }
                            Text {
                                text: "THOUGHT";
                                color: root.lens == 1 ? Pal.accent-hi
                                     : thought-ta.has-hover ? Pal.ink : Pal.ink2;
                                font-size: 10px;
                                letter-spacing: 1.4px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // query (Thought lens)
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                if root.lens == 1: HorizontalLayout {
                    spacing: 8px;
                    query := LineEdit {
                        height: 30px;
                        horizontal-stretch: 1;
                        placeholder-text: "recall… (watch the brain think)";
                        accepted(text) => { root.run-trace(text); }
                    }
                    Rectangle {
                        width: 54px;
                        height: 30px;
                        background: run-ta.has-hover ? #3a7de052 : #3a7de038;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #3a7de073;
                        run-ta := TouchArea { clicked => { root.run-trace(query.text); } }
                        Text {
                            text: root.busy ? "…" : "RUN";
                            color: Pal.accent-hi;
                            font-size: 10px;
                            letter-spacing: 1.4px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // refresh + reset view + connection dot
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 70px; height: 28px;
                        background: refresh-ta.has-hover ? #7a98c714 : transparent;
                        border-width: 1px;
                        border-color: Pal.panel-line;
                        border-radius: 6px;
                        refresh-ta := TouchArea { clicked => { root.refresh(); } }
                        Text {
                            text: "REFRESH";
                            color: Pal.ink2;
                            font-size: 10px;
                            letter-spacing: 1.2px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 28px; height: 28px;
                        background: home-ta.has-hover ? #7a98c714 : transparent;
                        border-width: 1px;
                        border-color: Pal.panel-line;
                        border-radius: 6px;
                        home-ta := TouchArea {
                            clicked => { root.view-cx = 0; root.view-cy = 0; root.zoom = 1; }
                        }
                        Text {
                            text: "FIT";
                            color: Pal.ink2;
                            font-size: 9px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 10px; height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: root.connected ? #3aa76c : #e05252;
                    }
                }
            }
        }
    }

    // ================= right rail =================
    Rectangle {
        x: root.width - self.width - 12px;
        y: 60px;
        width: 300px;
        height: root.height - 72px;
        background: Pal.panel;
        border-width: 1px;
        border-color: Pal.panel-line;
        border-radius: 8px;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            // which skull
            Text { text: "OBSERVATORY"; color: Pal.ink3; font-size: 9px; letter-spacing: 1.6px; }
            Text { text: root.db-line; color: Pal.ink2; font-size: 11px; wrap: word-wrap; }
            Text { text: root.api-line; color: Pal.ink3; font-size: 10px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Pal.panel-line; }

            // field honesty
            Text { text: root.meta-line; color: Pal.ink2; font-size: 11px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Pal.panel-line; }

            // stats + legend
            Text { text: "MEMORY"; color: Pal.ink3; font-size: 9px; letter-spacing: 1.6px; }
            Text { text: root.totals-line; color: Pal.ink; font-size: 12px; }
            for t in root.type-stats: HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 8px; height: 8px;
                    y: 4px;
                    border-radius: 4px;
                    background: t.hue;
                }
                Text { text: t.name; color: Pal.ink2; font-size: 11px; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: t.count; color: Pal.ink; font-size: 11px; }
            }

            // thought results
            if root.lens == 1: Rectangle { height: 1px; background: Pal.panel-line; }
            if root.lens == 1: Text {
                text: "RECALLED"; color: Pal.ink3; font-size: 9px; letter-spacing: 1.6px;
            }
            if root.lens == 1: Text {
                text: root.trace-meta; color: Pal.ink2; font-size: 11px; wrap: word-wrap;
            }
            if root.lens == 1: ListView {
                vertical-stretch: 1;
                for r in root.results: Rectangle {
                    height: 44px;
                    background: r-ta.has-hover ? #7a98c714 : transparent;
                    border-radius: 4px;
                    r-ta := TouchArea { clicked => { root.result-clicked(r.id); } }
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 8px;
                        Rectangle {
                            width: 8px; height: 8px;
                            y: 8px;
                            border-radius: 4px;
                            background: r.hue;
                            opacity: r.lit ? 1.0 : 0.45;
                        }
                        VerticalLayout {
                            spacing: 1px;
                            HorizontalLayout {
                                Text { text: r.rank; color: Pal.ink3; font-size: 10px; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: r.score; color: Pal.ink2; font-size: 10px; }
                            }
                            Text {
                                text: r.head;
                                color: r.lit ? Pal.ink : Pal.ink2;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            if root.lens == 0: Rectangle { vertical-stretch: 1; }

            // status footer
            Rectangle { height: 1px; background: Pal.panel-line; }
            Text { text: root.status-line; color: Pal.ink3; font-size: 10px; wrap: word-wrap; }
        }
    }

    // ================= pinned memory card (selection) =================
    if root.sel-visible: Rectangle {
        x: 12px;
        y: 60px;
        width: 380px;
        height: min(root.height - 72px, card-body.preferred-height + 24px);
        background: Pal.panel;
        border-width: 1px;
        border-color: Pal.panel-line;
        border-radius: 8px;
        clip: true;

        card-body := VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 10px; height: 10px;
                    y: 4px;
                    border-radius: 5px;
                    background: root.sel-hue;
                }
                Text {
                    text: root.sel-type;
                    color: root.sel-hue;
                    font-size: 11px;
                    letter-spacing: 1.2px;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 20px; height: 20px;
                    y: -2px;
                    background: close-ta.has-hover ? #7a98c71f : transparent;
                    border-radius: 4px;
                    close-ta := TouchArea { clicked => { root.dismiss(); } }
                    Text {
                        text: "×";
                        color: Pal.ink2;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text { text: root.sel-id; color: Pal.ink3; font-size: 10px; overflow: elide; }

            Flickable {
                height: min(380px, sel-text.preferred-height + 4px);
                viewport-height: sel-text.preferred-height + 4px;
                sel-text := Text {
                    width: parent.width;
                    text: root.sel-content;
                    color: Pal.ink;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            Text { text: root.sel-tags; color: Pal.accent; font-size: 10.5px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Pal.panel-line; }
            Text { text: root.sel-meta1; color: Pal.ink2; font-size: 10.5px; }
            Text { text: root.sel-meta2; color: Pal.ink2; font-size: 10.5px; }
            Text { text: root.sel-meta3; color: Pal.ink3; font-size: 10.5px; wrap: word-wrap; }
        }
    }
}
